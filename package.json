{
  "name": "@perfectpan/lint-config",
  "version": "0.8.0",
  "private": false,
  "description": "Shared oxlint, oxfmt and tsconfig rules for PerfectPan's JS/TS repositories",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerfectPan/lint-config.git"
  },
  "homepage": "https://github.com/PerfectPan/lint-config#readme",
  "bugs": {
    "url": "https://github.com/PerfectPan/lint-config/issues"
  },
  "type": "module",
  "exports": {
    "./oxlint.json": "./oxlint.json",
    "./oxfmt.json": "./oxfmt.json",
    "./jscpd.json": "./jscpd.json",
    "./jscpd-audit.json": "./jscpd-audit.json",
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/node.json": "./tsconfig/node.json",
    "./tsconfig/bundler.json": "./tsconfig/bundler.json",
    "./knip": {
      "types": "./knip.d.ts",
      "default": "./knip.js"
    },
    "./doc-translations": {
      "types": "./doc-translations.d.ts",
      "default": "./doc-translations.js"
    },
    "./vite-plus": {
      "types": "./vite-plus.d.ts",
      "default": "./vite-plus.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "oxlint.json",
    "oxfmt.json",
    "jscpd.json",
    "jscpd-audit.json",
    "tsconfig",
    "knip.js",
    "knip.d.ts",
    "knip.json",
    "doc-translations.js",
    "doc-translations.d.ts",
    "vite-plus.js",
    "vite-plus.d.ts",
    "tailwind",
    "shadcn"
  ],
  "scripts": {
    "test": "./scripts/self-test.sh",
    "test:floors": "pnpm -C test/floors install --no-frozen-lockfile && ./scripts/floors-test.sh"
  },
  "peerDependencies": {
    "eslint-plugin-better-tailwindcss": ">=4.10.0",
    "jscpd": ">=5.4.2 <6",
    "knip": ">=6.45.1 <7",
    "oxfmt": ">=0.57.0",
    "oxlint": ">=1.79.0",
    "oxlint-tsgolint": ">=0.24.0",
    "typescript": ">=6.0.2",
    "vite-plus": ">=0.2.4"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-better-tailwindcss": {
      "optional": true
    },
    "jscpd": {
      "optional": true
    },
    "knip": {
      "optional": true
    },
    "oxfmt": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "oxlint-tsgolint": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "vite-plus": {
      "optional": true
    }
  },
  "packageManager": "pnpm@12.8.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.13.1",
      "onFail": "error"
    }
  }
}
