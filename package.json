{
  "name": "@perfectpan/lint-config",
  "version": "0.6.1",
  "private": false,
  "description": "Shared oxlint, oxfmt and tsconfig rules for PerfectPan's JS/TS repositories",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerfectPan/lint-config.git"
  },
  "homepage": "https://github.com/PerfectPan/lint-config#readme",
  "bugs": {
    "url": "https://github.com/PerfectPan/lint-config/issues"
  },
  "type": "module",
  "exports": {
    "./oxlint.json": "./oxlint.json",
    "./oxfmt.json": "./oxfmt.json",
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/node.json": "./tsconfig/node.json",
    "./tsconfig/bundler.json": "./tsconfig/bundler.json",
    "./vite-plus": {
      "types": "./vite-plus.d.ts",
      "default": "./vite-plus.js"
    },
    "./tailwind": {
      "types": "./tailwind/index.d.ts",
      "default": "./tailwind/index.js"
    },
    "./shadcn": {
      "types": "./shadcn/index.d.ts",
      "default": "./shadcn/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "oxlint.json",
    "oxfmt.json",
    "tsconfig",
    "vite-plus.js",
    "vite-plus.d.ts",
    "tailwind",
    "shadcn"
  ],
  "scripts": {
    "test": "./scripts/self-test.sh"
  },
  "peerDependencies": {
    "eslint-plugin-better-tailwindcss": ">=4.10.0",
    "oxfmt": ">=0.57.0",
    "oxlint": ">=1.79.0",
    "oxlint-tsgolint": ">=0.24.0",
    "typescript": ">=6.0.0",
    "vite-plus": ">=0.2.4"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-better-tailwindcss": {
      "optional": true
    },
    "oxfmt": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "oxlint-tsgolint": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "vite-plus": {
      "optional": true
    }
  },
  "packageManager": "pnpm@12.8.1"
}
